flowchart LR
  subgraph P[Personas]
    SUP[Supervisor<br/>entidad pública]:::people
    COO[Coordinador<br/>organización ejecutora]:::people
    CAM[Equipo de campo]:::people
    VEE[Veedor o ciudadano]:::people
  end
  subgraph T[Truway]
    WA[Canal de WhatsApp]:::truway
    APP[App web]:::truway
    API[API de Truway]:::truway
    EXP[Explorador<br/>Prueba del gasto]:::truway
  end
  subgraph S[Stellar]
    BT[[budget-treasury<br/>una instancia por organización]]:::chain
    LED[(Ledger público)]:::chain
  end
  OTH[Exploradores e<br/>indexadores de terceros]:::ext
  CAM -- foto del recibo --> WA --> API
  COO -- propone --> APP --> API
  SUP -- aprueba --> APP
  API -- cada miembro firma su paso --> BT
  BT -- eventos Proof of Spend --> LED
  LED -- indexador --> API --> EXP
  VEE -- código del gasto --> EXP
  LED --> OTH
  VEE -. sin pasar por Truway .-> OTH

classDef chain fill:#1E42D8,stroke:#0B1F77,color:#FFFFFF
classDef ext fill:#F2F2F0,stroke:#8F9298,color:#272A30
classDef people fill:#FAF5E8,stroke:#C7A667,color:#332602
classDef soon fill:#FFFFFF,stroke:#8F9298,stroke-dasharray:5 4,color:#585B62
classDef truway fill:#F0F4FF,stroke:#243CA6,color:#111318
